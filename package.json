{
  "name": "pi-jev-control",
  "version": "0.8.0",
  "description": "Pluggable judgment control layer for Pi Coding Agent — Jev-compatible decision models, per-module backends, tool gating, failure classification, context pruning, and measurable savings",
  "private": true,
  "keywords": [
    "pi-package",
    "jev",
    "typesafe",
    "system-one",
    "decision-model",
    "router",
    "tool-gate",
    "ollama"
  ],
  "type": "module",
  "main": "./extensions/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:jev": "npm run build && node test/jev-smoke.mjs",
    "eval": "npm run build && node test/eval-backends.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "typebox": "^1.3.34"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
